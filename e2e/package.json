{
  "name": "@attestrack/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=api-smoke",
    "test:browser": "playwright test --project=browser-journeys",
    "test:all": "playwright test",
    "build:portal-live": "VITE_ATTESTRACK_API_BASE_URL=http://localhost:8788 pnpm --filter @attestrack/portal-community exec vite build --outDir ../../e2e/.portal-dist --emptyOutDir",
    "test:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@attestrack/host-cloudflare-worker": "workspace:*",
    "@attestrack/sdk": "workspace:*",
    "@attestrack/strategies": "workspace:*",
    "@attestrack/worker-core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.123.0"
  }
}
